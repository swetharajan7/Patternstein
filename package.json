{
  "name": "patternstein-movement-agent",
  "version": "1.0.0",
  "description": "Medical-grade movement analysis agent for Patternstein",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "mcp:start": "node dist/mcp-server.js",
    "mcp:dev": "tsx watch src/mcp-server.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@mediapipe/camera_utils": "^0.3.1675469404",
    "@mediapipe/pose": "^0.5.1675469404",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitest/ui": "^1.0.4",
    "eslint": "^8.56.0",
    "fast-check": "^3.15.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^1.0.4"
  },
  "keywords": [
    "mediapipe",
    "pose-detection",
    "movement-analysis",
    "medical-ai",
    "patternstein",
    "mcp"
  ],
  "author": "Patternstein Team",
  "license": "MIT"
}
